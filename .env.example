# =============================================================================
# CapSync - Environment Configuration Template (.env.example)
# Copy this file to .env and provide your actual Firebase credentials.
# cp .env.example .env
# =============================================================================

# Firebase Project Credentials (Web)
# Obtain these from Firebase Console -> Project Settings -> General -> Your Apps
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_web_app_id_here

# Firebase Project Credentials (Android)
FIREBASE_ANDROID_API_KEY=your_firebase_android_api_key_here
FIREBASE_ANDROID_APP_ID=your_firebase_android_app_id_here

FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
FIREBASE_PROJECT_ID=capsync-813b5
FIREBASE_AUTH_DOMAIN=capsync-813b5.firebaseapp.com

# Email OTP Service Options (Optional: local push notifications & demo autofill are active by default)
# Option A: Resend API (https://resend.com)
# RESEND_API_KEY=re_123456789
# Option B: Brevo / Sendinblue (https://brevo.com)
# BREVO_API_KEY=xkeysib-123456789
# Option C: EmailJS (https://emailjs.com)
# EMAILJS_SERVICE_ID=service_capsync
# EMAILJS_TEMPLATE_ID=template_otp
# EMAILJS_PUBLIC_KEY=your_public_key
# EMAILJS_PRIVATE_KEY=your_private_key

